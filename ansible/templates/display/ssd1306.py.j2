#!/usr/bin/env python3
# Managed by Ansible — do not edit manually
import socket
import time
import psutil
from luma.core.interface.serial import i2c
from luma.oled.device import ssd1306
from luma.core.render import canvas


def get_ip():
    for iface, addrs in psutil.net_if_addrs().items():
        if iface == 'lo':
            continue
        for addr in addrs:
            if addr.family == socket.AF_INET:
                return addr.address
    return 'no IP'


def get_uptime():
    with open('/proc/uptime') as f:
        secs = float(f.read().split()[0])
    h, rem = divmod(int(secs), 3600)
    return f'{h}h{rem // 60:02d}m'


def get_temp():
    try:
        with open('/sys/class/thermal/thermal_zone0/temp') as f:
            return int(f.read()) / 1000
    except Exception:
        return 0.0


serial = i2c(port={{ display.i2c_bus }}, address={{ display.i2c_address }})
device = ssd1306(serial)

while True:
    hostname = socket.gethostname()
    ip = get_ip()
    cpu = psutil.cpu_percent(interval=1)
    mem = psutil.virtual_memory().percent
    uptime = get_uptime()
    temp = get_temp()

    with canvas(device) as draw:
        draw.text((0,  0), hostname,                              fill='white')
        draw.text((0, 16), ip,                                    fill='white')
        draw.text((0, 32), f'CPU:{cpu:4.1f}%  {uptime}',         fill='white')
        draw.text((0, 48), f'MEM:{mem:4.1f}%  {temp:.0f}C',      fill='white')

    time.sleep(5)
