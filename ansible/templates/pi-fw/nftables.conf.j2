#!/usr/sbin/nft -f
# Managed by Ansible — do not edit manually

flush ruleset

define WAN = {{ pi_fw_wan_iface }}
define LAN = {{ pi_fw_lan_iface }}
define LAB  = {{ networking.lab_cidr }}
define IVPN = "wg-ivpn"
define TS_CGNAT = 100.64.0.0/10

# LAN-sourced packets get marked here (except anything destined for
# Tailscale's CGNAT range) so they're policy-routed via wg-ivpn instead of
# the main table's default WAN route. The exclusion is destination-based
# so it's correct for both directions of a Tailscale-routed flow -- without
# it, a LAN server's replies to a Tailscale-connected admin session would
# get shoved into the VPN tunnel instead of out tailscale0, breaking
# remote access mid-session.
#
# Priority is a plain -1, NOT the named "mangle" constant (-150). Confirmed
# live on 2026-07-29: a table registered at exactly "priority mangle" here
# breaks tailscaled's own SNAT setup for subnet-routed traffic the moment
# tailscaled (re)starts with this ruleset already active -- reproduced
# reliably (fresh reboot, and manually via `systemctl restart tailscaled`
# with this ruleset loaded), and confirmed fixed by moving off the exact
# "mangle" priority value while keeping the hook early enough (still
# pre-routing-decision) for policy routing to work. Do not change this
# back to "priority mangle" without re-testing a real reboot.
table inet mangle {
  chain prerouting {
    type filter hook prerouting priority -1; policy accept;

    iifname $LAN ip daddr != $TS_CGNAT meta mark set {{ services.ivpn.fwmark }}
  }
}

table inet filter {
  chain input {
    type filter hook input priority 0; policy drop;

    iif lo accept
    ct state established,related accept
    ct state invalid drop

    # ICMP
    ip  protocol icmp       accept
    ip6 nexthdr  icmpv6     accept

    # SSH — LAN and Tailscale only (never from WAN), key-auth only
    iifname { $LAN, "tailscale0" } tcp dport 22 accept

    # DNS and DHCP (dnsmasq)
    iifname { $LAN, "tailscale0" } udp dport 53 accept
    iifname { $LAN, "tailscale0" } tcp dport 53 accept
    iifname $LAN udp dport 67 accept

    # NTP
    iifname $LAN udp dport 123 accept

    # Tailscale control/data plane
    udp dport 41641 accept

    # Alloy log-push receiver -- pi-01..04 push their container logs here
    # over the LAN, then this host relays everything onward to chimaera's
    # Loki over Tailscale. LAN-only: pi-fw's own outbound push to chimaera
    # needs no inbound rule, and nothing outside the LAN pushes in here.
    iifname $LAN tcp dport {{ services.log_aggregation.port }} accept

    # Log (rate-limited) and drop everything else
    limit rate 5/second burst 10 packets log prefix "nft-drop-input: " flags all
    drop
  }

  chain forward {
    type filter hook forward priority 0; policy drop;

    ct state established,related accept
    ct state invalid drop

    # Lab → IVPN only. This is the binding fail-closed guarantee: even if
    # the routing layer ever falls through to the main table's WAN default
    # route (e.g. table {{ services.ivpn.table }} empty for a moment), this
    # chain has no rule accepting LAN traffic with oifname $WAN anymore, and
    # the default policy is drop -- so it dies here regardless.
    iifname $LAN oifname $IVPN accept

    # Tailscale subnet routing: remote clients ↔ lab
    iifname "tailscale0" oifname $LAN accept
    iifname $LAN oifname "tailscale0" accept

    limit rate 5/second burst 10 packets log prefix "nft-drop-forward: " flags all
    drop
  }

  chain output {
    type filter hook output priority 0; policy accept;
  }
}

table inet nat {
  chain postrouting {
    type nat hook postrouting priority 100; policy accept;

    iifname $LAN oifname $IVPN masquerade
  }
}
