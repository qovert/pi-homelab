# Managed by Ansible — do not edit manually

interface={{ pi_fw_lan_iface }}
interface=tailscale0
bind-interfaces
domain-needed
bogus-priv
no-resolv

# Upstream DNS — IVPN's resolver only, reachable via wg-ivpn's PostUp host
# route. Deliberately no fallback: a fallback would leak DNS around the
# tunnel if it's down, defeating the fail-closed intent.
server={{ services.ivpn.dns }}

# Local domain — never forward lab.{{ lab.domain }} queries upstream
local=/lab.{{ lab.domain }}/
domain=lab.{{ lab.domain }}
no-hosts

# DHCP
dhcp-range={{ networking.dhcp_range_start }},{{ networking.dhcp_range_end }},24h
dhcp-option=option:router,{{ networking.gateway }}
dhcp-option=option:dns-server,{{ networking.gateway }}

# DHCP reservations
{% for host in groups['pi_nodes'] | sort %}
{% if hostvars[host].dhcp_mac is defined %}
dhcp-host={{ hostvars[host].dhcp_mac }},{{ hostvars[host].ansible_host }},{{ host }},infinite
{% endif %}
{% endfor %}

# Static DNS entries
{% for name, ip in inventory_hosts.items() %}
address=/{{ name | replace('_', '-') }}.lab.{{ lab.domain }}/{{ ip }}
{% endfor %}
