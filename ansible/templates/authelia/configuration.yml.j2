# Managed by Ansible — do not edit manually
# Secrets are supplied via environment variables (see authelia.env).

theme: dark

server:
  address: tcp://0.0.0.0:9091

log:
  level: info

totp:
  issuer: {{ lab.domain }}

authentication_backend:
  password_reset:
    disable: false
  ldap:
    implementation: lldap
    address: ldap://lldap:3890
    base_dn: {{ services.ldap.base_dn }}
    user: uid=admin,ou=people,{{ services.ldap.base_dn }}

access_control:
  default_policy: two_factor

session:
  name: authelia_session
  expiration: 1h
  inactivity: 15m
  remember_me: 1M
  cookies:
    - domain: {{ lab.domain }}
      authelia_url: https://{{ services.authelia.fqdn }}
      default_redirection_url: https://{{ lab.domain }}

regulation:
  max_retries: 4
  find_time: 2m
  ban_time: 10m

storage:
  local:
    path: /data/db.sqlite3

identity_providers:
  oidc:
    claims_policies:
      cloudflare:
        id_token:
          - email
          - email_verified
          - name
          - preferred_username
          - groups
    jwks:
      - key: |
          {{ vault.authelia.oidc_private_key | indent(10) }}
    clients:
      - client_id: cloudflare-access
        client_name: Cloudflare Access
        client_secret: "{{ vault.authelia.oidc_clients.cloudflare_access.secret_hash }}"
        public: false
        authorization_policy: two_factor
        redirect_uris:
          - https://sparkling-recipe-d640.cloudflareaccess.com/cdn-cgi/access/callback
        scopes:
          - openid
          - profile
          - email
          - groups
        grant_types:
          - authorization_code
        response_types:
          - code
        token_endpoint_auth_method: client_secret_basic
        claims_policy: cloudflare

      - client_id: miniflux
        client_name: Miniflux
        client_secret: "{{ vault.miniflux.oidc_client_secret_hash }}"
        public: false
        authorization_policy: two_factor
        redirect_uris:
          - https://{{ services.miniflux.fqdn }}/oauth2/oidc/callback
        scopes:
          - openid
          - profile
          - email
        grant_types:
          - authorization_code
        response_types:
          - code
        token_endpoint_auth_method: client_secret_basic

      - client_id: nextcloud
        client_name: Nextcloud
        client_secret: "{{ vault.nextcloud.oidc_client_secret_hash }}"
        public: false
        authorization_policy: two_factor
        redirect_uris:
          - https://{{ services.nextcloud.fqdn }}/apps/user_oidc/code
        scopes:
          - openid
          - profile
          - email
          - groups
        grant_types:
          - authorization_code
        response_types:
          - code
        token_endpoint_auth_method: client_secret_post

      - client_id: vaultwarden
        client_name: Vaultwarden
        client_secret: "{{ vault.vaultwarden.oidc_client_secret_hash }}"
        public: false
        authorization_policy: two_factor
        redirect_uris:
          - https://{{ services.vaultwarden.fqdn }}/identity/connect/oidc-signin
        scopes:
          - openid
          - profile
          - email
        grant_types:
          - authorization_code
        response_types:
          - code
        token_endpoint_auth_method: client_secret_basic

notifier:
  # The IdP must not fail to boot if mail is unavailable — a mail outage should
  # never lock you out of every service. Delivery is still attempted at runtime.
  disable_startup_check: true
{% if services.mail.notifier | default('smtp') == 'filesystem' %}
  # Writes notifications (2FA enrollment / password-reset links) to a file
  # instead of emailing — useful when mail delivery is unavailable.
  # On host: {{ storage.data_dir }}/authelia/notification.txt
  filesystem:
    filename: /data/notification.txt
{% else %}
  smtp:
    address: {{ 'submissions' if services.mail.relay_security | default('starttls') == 'ssl' else 'submission' }}://{{ services.mail.relay_host }}:{{ services.mail.relay_port }}
    username: {{ vault.smtp.relay_user }}
    sender: "Authelia <noreply@{{ services.mail.sender_domain }}>"
{% endif %}
