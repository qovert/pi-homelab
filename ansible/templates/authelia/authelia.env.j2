# Managed by Ansible — do not edit manually
TZ=UTC
X_AUTHELIA_CONFIG=/config/configuration.yml
AUTHELIA_SESSION_SECRET={{ vault.authelia.session_secret }}
AUTHELIA_STORAGE_ENCRYPTION_KEY={{ vault.authelia.storage_encryption_key }}
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET={{ vault.authelia.jwt_secret }}
AUTHELIA_AUTHENTICATION_BACKEND_LDAP_PASSWORD={{ vault.lldap.admin_password }}
{% if services.mail.notifier | default('smtp') == 'smtp' %}
AUTHELIA_NOTIFIER_SMTP_PASSWORD={{ vault.smtp.relay_password }}
{% endif %}
