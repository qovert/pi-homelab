# Managed by Ansible — do not edit manually

MONGO_URL=mongodb://rocketchat-mongo:27017/rocketchat?replicaSet=rs0
MONGO_OPLOG_URL=mongodb://rocketchat-mongo:27017/local?replicaSet=rs0

ROOT_URL=https://{{ services.rocketchat.fqdn }}
PORT=3000

OVERWRITE_SETTING_Show_Setup_Wizard=completed
ADMIN_USERNAME={{ vault.rocketchat.admin_user }}
ADMIN_PASS={{ vault.rocketchat.admin_password }}
ADMIN_EMAIL={{ lab.admin_email }}

# Outbound mail relay via mail-01's Mailu (same relay every other app in
# this lab uses -- see vault.smtp / services.mail). Set via env override
# rather than the admin API since settings changes there require the
# admin's own TOTP step-up, which a deploy has no way to provide.
OVERWRITE_SETTING_SMTP_Host={{ services.mail.relay_host }}
OVERWRITE_SETTING_SMTP_Port={{ services.mail.relay_port }}
OVERWRITE_SETTING_SMTP_Username={{ vault.smtp.relay_user }}
OVERWRITE_SETTING_SMTP_Password={{ vault.smtp.relay_password }}
OVERWRITE_SETTING_SMTP_Protocol=smtps
