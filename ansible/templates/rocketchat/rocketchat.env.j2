# Managed by Ansible — do not edit manually

MONGO_URL=mongodb://rocketchat-mongo:27017/rocketchat?replicaSet=rs0
MONGO_OPLOG_URL=mongodb://rocketchat-mongo:27017/local?replicaSet=rs0

ROOT_URL=https://{{ services.rocketchat.fqdn }}
PORT=3000

OVERWRITE_SETTING_Show_Setup_Wizard=completed
ADMIN_USERNAME={{ vault.rocketchat.admin_user }}
ADMIN_PASS={{ vault.rocketchat.admin_password }}
ADMIN_EMAIL={{ lab.admin_email }}

# Outbound mail relay via mail-01's Mailu (same relay every other app in
# this lab uses -- see vault.smtp / services.mail). Set via env override
# rather than the admin API since settings changes there require the
# admin's own TOTP step-up, which a deploy has no way to provide.
OVERWRITE_SETTING_SMTP_Host={{ services.mail.relay_host }}
OVERWRITE_SETTING_SMTP_Port={{ services.mail.relay_port }}
OVERWRITE_SETTING_SMTP_Username={{ vault.smtp.relay_user }}
OVERWRITE_SETTING_SMTP_Password={{ vault.smtp.relay_password }}
OVERWRITE_SETTING_SMTP_Protocol=smtps

# SSO via Authelia (OIDC) -- registered as client_id "rocketchat" in
# authelia/configuration.yml.j2. The Custom OAuth service is displayed as
# "Authelia" (capital A) in the admin UI/settings IDs below, but its actual
# callback route is keyed off the lowercase internal service name
# ("authelia"), confirmed live via server logs (CustomOAuth "Init
# CustomOAuth" logs name="authelia") and by testing both casings directly --
# only /_oauth/authelia (lowercase) reaches oauth_server.js at all. This is
# what authelia/configuration.yml.j2's redirect_uris entry must match.
#
# key_field must be a claim Authelia's userinfo response actually returns
# (sub/preferred_username/email/name -- there is no "username" claim, which
# is the field's own default and silently breaks login with "User not
# found [401]" even though the identity response itself is fine).
OVERWRITE_SETTING_Accounts_OAuth_Custom-Authelia=true
OVERWRITE_SETTING_Accounts_OAuth_Custom-Authelia-url=https://{{ services.authelia.fqdn }}
OVERWRITE_SETTING_Accounts_OAuth_Custom-Authelia-authorize_path=/api/oidc/authorization
OVERWRITE_SETTING_Accounts_OAuth_Custom-Authelia-token_path=/api/oidc/token
OVERWRITE_SETTING_Accounts_OAuth_Custom-Authelia-identity_path=/api/oidc/userinfo
OVERWRITE_SETTING_Accounts_OAuth_Custom-Authelia-token_sent_via=header
OVERWRITE_SETTING_Accounts_OAuth_Custom-Authelia-identity_token_sent_via=header
OVERWRITE_SETTING_Accounts_OAuth_Custom-Authelia-scope=openid profile email
OVERWRITE_SETTING_Accounts_OAuth_Custom-Authelia-id=rocketchat
OVERWRITE_SETTING_Accounts_OAuth_Custom-Authelia-secret={{ vault.rocketchat.oidc_client_secret }}
OVERWRITE_SETTING_Accounts_OAuth_Custom-Authelia-login_style=redirect
OVERWRITE_SETTING_Accounts_OAuth_Custom-Authelia-button_label_text=Authelia
OVERWRITE_SETTING_Accounts_OAuth_Custom-Authelia-merge_users=true
OVERWRITE_SETTING_Accounts_OAuth_Custom-Authelia-key_field=sub
OVERWRITE_SETTING_Accounts_OAuth_Custom-Authelia-username_field=preferred_username
OVERWRITE_SETTING_Accounts_OAuth_Custom-Authelia-email_field=email
