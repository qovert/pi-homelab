# Postgres
POSTGRES_USER=miniflux
POSTGRES_PASSWORD={{ vault.miniflux.db_password }}
POSTGRES_DB=miniflux

# Miniflux
DATABASE_URL=postgres://miniflux:{{ vault.miniflux.db_password }}@postgres/miniflux?sslmode=disable
RUN_MIGRATIONS=1
CREATE_ADMIN=1
ADMIN_USERNAME={{ vault.miniflux.admin_user }}
ADMIN_PASSWORD={{ vault.miniflux.admin_password }}
BASE_URL=https://{{ services.miniflux.fqdn }}
