[Unit]
Description=Nextcloud Postgres
After=network-online.target local-fs.target

[Container]
Image=docker.io/library/postgres:16-alpine
ContainerName=nextcloud-db
HostName=postgres
EnvironmentFile=/opt/nextcloud/nextcloud.env
Volume={{ storage.data_dir }}/nextcloud/postgres:/var/lib/postgresql/data
Network=nextcloud-net.network
HealthCmd=pg_isready -U nextcloud -d nextcloud
HealthInterval=10s
HealthRetries=5
HealthStartPeriod=20s

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
