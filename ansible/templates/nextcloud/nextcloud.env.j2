# Postgres
POSTGRES_HOST=postgres
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD={{ vault.nextcloud.db_password }}

# Nextcloud
NEXTCLOUD_ADMIN_USER={{ vault.nextcloud.admin_user }}
NEXTCLOUD_ADMIN_PASSWORD={{ vault.nextcloud.admin_password }}
NEXTCLOUD_TRUSTED_DOMAINS={{ services.nextcloud.fqdn }}
REDIS_HOST=redis

# Reverse proxy (Cloudflare Tunnel terminates TLS; cloudflared connects from pi-fw)
TRUSTED_PROXIES={{ networking.gateway }}
OVERWRITEPROTOCOL=https
OVERWRITEHOST={{ services.nextcloud.fqdn }}
OVERWRITECLIURL=https://{{ services.nextcloud.fqdn }}
SMTP_HOST={{ services.mail.relay_host }}
SMTP_PORT={{ services.mail.relay_port }}
SMTP_AUTHTYPE=LOGIN
SMTP_NAME={{ vault.smtp.relay_user }}
SMTP_PASSWORD={{ vault.smtp.relay_password }}
SMTP_SECURE={{ 'ssl' if services.mail.relay_security | default('starttls') == 'ssl' else 'tls' }}
MAIL_FROM_ADDRESS=noreply
MAIL_DOMAIN={{ services.mail.sender_domain }}
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_LIMIT=512M
