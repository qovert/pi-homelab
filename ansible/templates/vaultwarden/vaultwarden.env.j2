# Managed by Ansible — do not edit manually
DOMAIN=https://{{ services.vaultwarden.fqdn }}
ADMIN_TOKEN={{ vault.vaultwarden.admin_token }}
SIGNUPS_ALLOWED=false
WEBSOCKET_ENABLED=false

# SMTP
SMTP_HOST={{ services.mail.relay_host }}
SMTP_PORT={{ services.mail.relay_port }}
SMTP_SECURITY={{ 'force_tls' if services.mail.relay_security | default('starttls') == 'ssl' else 'starttls' }}
SMTP_USERNAME={{ vault.smtp.relay_user }}
SMTP_PASSWORD={{ vault.smtp.relay_password }}
SMTP_FROM=noreply@{{ services.mail.sender_domain }}

# OIDC SSO (Authelia)
SSO_ENABLED=true
SSO_CLIENT_ID=vaultwarden
SSO_CLIENT_SECRET={{ vault.vaultwarden.oidc_client_secret }}
SSO_AUTHORITY=https://{{ services.authelia.fqdn }}
